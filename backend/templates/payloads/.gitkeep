# Payload templates directory
#
# Each vulnerability class gets its own YAML file here.
# Format (example — xss.yaml):
#
# template_id: xss-reflected
# title: Reflected Cross-Site Scripting
# severity: high
# cwe: CWE-79
# owasp: "A03:2021 – Injection"
# cvss_score: 7.2
# remediation: >
#   Encode all user-supplied data before inserting it into HTML contexts.
#   Use context-aware output encoding and a strict Content-Security-Policy.
# payloads:
#   - '<script>alert(1)</script>'
#   - '"><svg onload=alert(1)>'
#   - "';alert(1)//"
# detection:
#   type: reflection          # 'reflection' | 'error_pattern' | 'time_delay'
#   pattern: null             # regex for error_pattern type
#   reflect_payload: true     # check if payload appears in response body
