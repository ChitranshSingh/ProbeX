# ProbeX – environment variables
# Copy this file to .env (never commit .env to version control)

# SQLAlchemy connection string — defaults to a local SQLite file in backend/
DATABASE_URL=sqlite:///./probex.db

# Google Generative AI key — leave blank to disable AI remediation
GEMINI_API_KEY=your_key_here

# Origin allowed through CORS (Vite dev server default)
FRONTEND_ORIGIN=http://localhost:5173
