# ProbeX – environment variables
# Copy this file to .env (never commit .env to version control)

# SQLAlchemy connection string — defaults to a local SQLite file in backend/
DATABASE_URL=sqlite:///./probex.db

# Google Generative AI key — leave blank to disable AI remediation
GEMINI_API_KEY=your_key_here

# Origin allowed through CORS (Vite dev server default)
FRONTEND_ORIGIN=http://localhost:5173

# Keep false for shared deployments. Set true only for an owned local lab.
ALLOW_PRIVATE_TARGETS=false
MAX_CONCURRENT_SCANS=2
MAX_REQUESTS_PER_SECOND=3
# Applied to public deployments; local-lab mode bypasses it deliberately.
SCAN_RATE_LIMIT=3
SCAN_RATE_WINDOW_SECONDS=600
